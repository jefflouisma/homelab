    {
      "mode": "managed",
      "type": "kubernetes_secret",
      "name": "freeipa_cloudinit",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": null,
            "binary_data_wo": null,
            "binary_data_wo_revision": null,
            "data": {
              "userdata": "#cloud-config\n# FreeIPA Server Auto-Installation for Barleta\n# This cloud-init configures FreeIPA automatically on first boot\n\nhostname: ipa.barleta.local\nfqdn: ipa.barleta.local\nmanage_etc_hosts: true\n\nusers:\n  - name: fedora\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    ssh_authorized_keys:\n      - ssh-rsa  jefflouisma@me.com\n\nwrite_files:\n  - path: /root/install-freeipa.sh\n    permissions: '0755'\n    content: |\n      #!/bin/bash\n      set -e\n      \n      # FreeIPA Configuration\n      IPA_REALM=\"BARLETA.LOCAL\"\n      IPA_DOMAIN=\"barleta.local\"\n      IPA_HOSTNAME=\"ipa.barleta.local\"\n      IPA_ADMIN_PASSWORD=\"FreeIPAAdmin2024!\"\n      IPA_DS_PASSWORD=\"DirectoryServer2024!\"\n      \n      # Wait for network\n      sleep 30\n      \n      # Update /etc/hosts\n      echo \"$(hostname -I | awk '{print $1}') ${IPA_HOSTNAME} ipa\" \u003e\u003e /etc/hosts\n      \n      # Install FreeIPA packages\n      dnf install -y freeipa-server freeipa-server-dns freeipa-server-trust-ad\n      \n      # Check if already installed\n      if [ -f /etc/ipa/default.conf ]; then\n        echo \"FreeIPA already installed\"\n        exit 0\n      fi\n      \n      # Install FreeIPA server (unattended)\n      ipa-server-install \\\n        --realm=${IPA_REALM} \\\n        --domain=${IPA_DOMAIN} \\\n        --hostname=${IPA_HOSTNAME} \\\n        --ds-password=${IPA_DS_PASSWORD} \\\n        --admin-password=${IPA_ADMIN_PASSWORD} \\\n        --mkhomedir \\\n        --no-ntp \\\n        --no-host-dns \\\n        --unattended\n      \n      # Enable firewall rules\n      firewall-cmd --permanent --add-service=freeipa-ldap || true\n      firewall-cmd --permanent --add-service=freeipa-ldaps || true\n      firewall-cmd --permanent --add-service=dns || true\n      firewall-cmd --permanent --add-service=http || true\n      firewall-cmd --permanent --add-service=https || true\n      firewall-cmd --permanent --add-service=kerberos || true\n      firewall-cmd --permanent --add-service=kpasswd || true\n      firewall-cmd --reload || true\n      \n      echo \"FreeIPA installation complete!\"\n\nruncmd:\n  - /root/install-freeipa.sh \u003e /var/log/freeipa-install.log 2\u003e\u00261 \u0026\n"
            },
            "data_wo": null,
            "data_wo_revision": null,
