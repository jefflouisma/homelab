# HomePractice OPNsense Configuration - Terraform Variables
# Copy this to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to git!
#
# IMPORTANT: These credentials MUST match what was set in the infrastructure layer
# (homepractice/infrastructure/terraform.tfvars)

# OPNsense API URL (WAN IP of OPNsense)
opnsense_url = "https://192.168.1.1"

# OPNsense API Credentials - MUST match infrastructure layer
opnsense_api_key    = "your-40-char-api-key"
opnsense_api_secret = "your-40-char-api-secret-plaintext"

# Network Configuration (defaults match HomePractice setup)
# wan_gateway        = "192.168.1.254"
# lan_network        = "10.10.10.0/24"
# management_network = "192.168.1.0/24"
