# nvidia-uvm.ko Builder for Harvester
# Builds nvidia-uvm kernel module for SLE Micro 6.1 kernel
#
# Uses OpenSUSE Leap 15.6 with kernel-devel to cross-compile
# the nvidia-uvm.ko module from NVIDIA open-source drivers.
#
# Usage:
#   docker build -t nvidia-uvm-builder -f Dockerfile.uvm-builder .
#   docker run --rm nvidia-uvm-builder cat /output/nvidia-uvm.ko > nvidia-uvm.ko

FROM opensuse/leap:15.6

# Driver version matching Harvester's installed driver
ARG DRIVER_VERSION=580.119.02

ENV DRIVER_VERSION=${DRIVER_VERSION}

# Install build dependencies
RUN zypper --non-interactive refresh && \
    zypper --non-interactive install -y \
        gcc \
        gcc-c++ \
        make \
        kernel-default-devel \
        bc \
        flex \
        bison \
        wget \
        tar \
        gzip \
        libelf-devel \
        openssl-devel \
        kmod \
        && zypper clean --all

# Show kernel version we're building for (no prepare needed for external modules)
RUN KERNEL_VERSION=$(ls /usr/src/linux-* -d | head -1 | sed 's|/usr/src/linux-||') && \
    echo "Building for kernel: ${KERNEL_VERSION}" && \
    ls -la /usr/src/linux-${KERNEL_VERSION}/ | head -10

# Download NVIDIA open-source driver
RUN wget -q "https://download.nvidia.com/XFree86/Linux-x86_64/${DRIVER_VERSION}/NVIDIA-Linux-x86_64-${DRIVER_VERSION}.run" \
    -O /nvidia-driver.run && \
    chmod +x /nvidia-driver.run

# Extract driver source (don't run installer, just extract)
RUN /nvidia-driver.run --extract-only --target /nvidia-src && \
    ls -la /nvidia-src/

# Create output directory
RUN mkdir -p /output

# Build kernel modules manually from kernel-open source
# The nvidia-open modules are in kernel-open/ directory
WORKDIR /nvidia-src/kernel-open

# Get kernel version and build modules using the Makefile
RUN KERNEL_VERSION=$(ls /usr/src/linux-* -d | head -1 | sed 's|/usr/src/linux-||') && \
    echo "Building NVIDIA open kernel modules for: ${KERNEL_VERSION}" && \
    echo "Contents of kernel-open:" && ls -la && \
    echo "Building nvidia modules..." && \
    make -j$(nproc) modules \
        SYSSRC=/usr/src/linux-${KERNEL_VERSION} \
        KERNEL_SOURCES=/usr/src/linux-${KERNEL_VERSION} \
    2>&1 | tee /tmp/build.log || (echo "Build output:"; cat /tmp/build.log; echo "Build may have failed, checking for .ko files...")

# Find and copy all built kernel modules to output
RUN echo "Looking for .ko files in /nvidia-src..." && \
    find /nvidia-src -name "*.ko" -type f 2>/dev/null | head -20 && \
    find /nvidia-src -name "*.ko" -type f -exec cp {} /output/ \; 2>/dev/null || true && \
    echo "=== Built modules in output ===" && \
    ls -la /output/

# Verify nvidia-uvm.ko was built
RUN if [ -f "/output/nvidia-uvm.ko" ] || [ -f "/output/nvidia-uvm.ko.xz" ]; then \
        echo "SUCCESS: nvidia-uvm.ko built!"; \
        ls -la /output/nvidia*; \
    else \
        echo "WARNING: nvidia-uvm.ko not found in output, checking other locations:"; \
        find / -name "nvidia-uvm*" -type f 2>/dev/null | head -20; \
    fi

# Default command shows what was built
CMD ["ls", "-la", "/output/"]
