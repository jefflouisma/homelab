# nvidia-uvm.ko Builder for Harvester
# Builds nvidia-uvm kernel module for SLE Micro 6.1 kernel 6.4.0-36-default
#
# This image uses SUSE SLE 15 SP6 with kernel-devel to cross-compile
# the nvidia-uvm.ko module from NVIDIA open-source drivers.
#
# Usage:
#   docker build -t nvidia-uvm-builder .
#   docker run --rm nvidia-uvm-builder cat /output/nvidia-uvm.ko > nvidia-uvm.ko

FROM registry.suse.com/bci/bci-base:15.6

# Target kernel version (must match Harvester's kernel)
ARG KERNEL_VERSION=6.4.0-36-default
ARG DRIVER_VERSION=580.119.02

ENV KERNEL_VERSION=${KERNEL_VERSION}
ENV DRIVER_VERSION=${DRIVER_VERSION}

# Install build dependencies
RUN zypper --non-interactive refresh && \
    zypper --non-interactive install -y \
        gcc \
        make \
        kernel-default-devel \
        kernel-source \
        wget \
        tar \
        gzip \
        elfutils-libelf-devel \
        && zypper clean --all

# Download NVIDIA open-source driver
RUN wget -q "https://download.nvidia.com/XFree86/Linux-x86_64/${DRIVER_VERSION}/NVIDIA-Linux-x86_64-${DRIVER_VERSION}.run" \
    -O /nvidia-driver.run && \
    chmod +x /nvidia-driver.run

# Extract driver (don't run installer, just extract source)
RUN /nvidia-driver.run --extract-only --target /nvidia-src

# Create output directory
RUN mkdir -p /output

# Build nvidia-uvm kernel module
# The open-source driver has nvidia-uvm in kernel-open/nvidia-uvm/
WORKDIR /nvidia-src/kernel-open

# Build just nvidia-uvm module
# Note: We need to specify KERNEL_SOURCES and SYSSRC for the build
RUN make -j$(nproc) modules \
    KERNEL_VERSION=${KERNEL_VERSION} \
    SYSSRC=/usr/src/linux-${KERNEL_VERSION} \
    KERNEL_SOURCES=/usr/src/linux-${KERNEL_VERSION} \
    NV_KERNEL_SOURCES=/usr/src/linux-${KERNEL_VERSION} \
    || echo "Build may have partial success, checking for nvidia-uvm.ko..."

# Copy built modules to output
RUN find /nvidia-src -name "nvidia-uvm.ko" -exec cp {} /output/ \; && \
    find /nvidia-src -name "nvidia*.ko" -exec cp {} /output/ \; && \
    ls -la /output/

# Default command shows what was built
CMD ["ls", "-la", "/output/"]
