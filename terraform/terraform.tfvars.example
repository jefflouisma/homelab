# Terraform Variables Template
# Copy this file to terraform.tfvars and fill in your actual values.
# NEVER commit terraform.tfvars to git!

# ArgoCD SSH deploy key for private repo access
# Generate with: ssh-keygen -t ed25519 -C "argocd-deploy-key" -f argocd-deploy-key
# Add the PUBLIC key to GitHub: https://github.com/YOUR_USER/YOUR_REPO/settings/keys
argocd_deploy_key = <<-EOT
-----BEGIN OPENSSH PRIVATE KEY-----
YOUR_PRIVATE_KEY_HERE
-----END OPENSSH PRIVATE KEY-----
EOT

# GitHub App credentials for Actions Runner Controller
# Create at: https://github.com/settings/apps/new
# Required permissions: Actions (read), Administration (read/write), Metadata (read)
github_app_id              = "YOUR_APP_ID"
github_app_installation_id = "YOUR_INSTALLATION_ID"

github_app_private_key = <<-EOT
-----BEGIN RSA PRIVATE KEY-----
YOUR_GITHUB_APP_PRIVATE_KEY_HERE
-----END RSA PRIVATE KEY-----
EOT
